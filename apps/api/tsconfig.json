{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "exactOptionalPropertyTypes": false,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "prisma/**/*.ts",
    "prisma7.config.ts"
  ],
  "exclude": [
    "node_modules",
    "src/generated"
  ]
}